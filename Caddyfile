# One address for everything. That's the only reason Caddy is here.
#
# The frontend and the API share a hostname, which keeps the login cookie
# first-party so browsers don't block it, and means there's no CORS to set up.
# See docs/adr/0003-single-origin.md.
#
# In P7 the address below becomes the real hostname and Caddy sorts out HTTPS by
# itself. The routes don't change.

{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	log {
		output stdout
		format console
	}

	# ---- Everything the API handles --------------------------------------
	# FastAPI serves its own docs and schema under /api too, so this one rule
	# covers the whole API including /api/docs.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Logins coming in. The identity provider posts here (P2).
	handle /saml/* {
		reverse_proxy api:8000
	}

	# Accounts coming in. The identity provider creates users here (P3).
	handle /scim/* {
		reverse_proxy api:8000
	}

	# Logins going out, once we're the one signing people in (P5).
	handle /idp/* {
		reverse_proxy api:8000
	}

	# ---- Everything else is the frontend ---------------------------------
	# Locally that's the Vite dev server, and Caddy passes the hot-reload
	# websocket through as-is.
	#
	# P7 NOTE: when this changes to serving the built files, it needs a fallback
	# to index.html:
	#
	#   handle {
	#       root * /srv/dist
	#       try_files {path} /index.html
	#       file_server
	#   }
	#
	# Right now /users and /groups only work because Vite serves index.html for
	# paths it doesn't recognise. A plain file_server would 404 on every deep link
	# and only the home page would load.
	handle {
		reverse_proxy web:5173
	}
}
