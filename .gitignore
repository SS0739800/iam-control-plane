# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Node ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Secrets and local config ---
# .env.example IS committed; .env never is.
.env
.env.local
.env.*.local

# --- Local signing material (generated per developer, never shared) ---
certs/
*.pem
*.key
*.crt
!certs/.gitkeep

# Two exceptions, and only two. The SAML test fixtures include the certificates
# that verify the recorded authentik assertion, and without them the reader and
# signer tests cannot even be collected — which is exactly how they failed the
# first time CI ever ran: the .b64 assertion was committed and the certificates
# that make sense of it were not.
#
# Public halves, checked before allowing them: both are BEGIN CERTIFICATE with no
# private key material. The rule above stays as it is, because it is the thing
# stopping somebody committing a signing key, and that is worth far more than the
# inconvenience of this exception.
!apps/api/tests/fixtures/*.pem

# --- Docker / infra local state ---
.caddy/
pgdata/

# --- Editors and OS ---
# Editor state is personal, but these two are project configuration: they point
# the editor at the venv under apps/api and keep formatting consistent with CI.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store
