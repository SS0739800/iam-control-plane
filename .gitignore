# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Node ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- Secrets and local config ---
# .env.example IS committed; .env never is.
.env
.env.local
.env.*.local

# --- Local signing material (generated per developer, never shared) ---
certs/
*.pem
*.key
*.crt
!certs/.gitkeep

# --- Docker / infra local state ---
.caddy/
pgdata/

# --- Editors and OS ---
# Editor state is personal, but these two are project configuration: they point
# the editor at the venv under apps/api and keep formatting consistent with CI.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store
