# Use Unix line endings everywhere, both in the repo and when files are checked
# out.
#
# This isn't about style. Some of these files get read directly by Linux
# containers, and Git on Windows would otherwise convert them to Windows line
# endings, which breaks them:
#
#   infra/db/init/*.sh   -> "bad interpreter: /bin/bash^M", database setup fails
#   Dockerfile           -> RUN lines break in odd ways
#   Caddyfile            -> won't parse
#
# eol=lf wins over whatever anyone has set locally, which is the point.
* text=auto eol=lf

# Shell scripts especially. Called out separately because this is the one that
# fails most confusingly.
*.sh text eol=lf

# Never touched by EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated; keep it out of diffs and reviews.
apps/web/package-lock.json linguist-generated=true -diff
