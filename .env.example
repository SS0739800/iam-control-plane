# Copy to .env and adjust. Never commit .env.
#
#   cp .env.example .env
#
# docker compose reads this file automatically and injects these into the api
# container. For running the API natively, activate the venv and export these
# yourself (see README).

# ---------------------------------------------------------------- application
APP_ENV=local
LOG_LEVEL=INFO

# The one address everything is served from. Caddy listens here, and the frontend,
# the API and the SAML and SCIM endpoints all sit behind it. In P7 this becomes
# your real https address, and the SAML URLs get built from it.
BASE_URL=http://localhost:8080

# Signs the session cookie. Generate a real one for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-not-a-real-secret-change-me

# ----------------------------------------------------------------- database
# Local Postgres from docker compose. In production these point at Neon, and the
# two stop being the same. See the notes below.
#
# A URL copied from any hosted provider ends "?sslmode=require". That is libpq's
# spelling and asyncpg does not accept it, so iam/config.py rewrites the key to
# "ssl=". Paste the URL as given; it is handled.
DATABASE_URL=postgresql+asyncpg://iam:iam@db:5432/iam
ALEMBIC_DATABASE_URL=postgresql+asyncpg://iam:iam@db:5432/iam

# direct | session | transaction
#
# Local Postgres is "direct". A hosted provider gives you more than one way to
# connect and picking the wrong one costs you an afternoon:
#
#   transaction  <- what the app uses in production. Neon's "-pooler" host,
#                   Supabase's port 6543. Breaks prepared statements, so db.py
#                   turns those off and lets the pooler do the pooling.
#   session      <- what migrations use: Neon's direct host, Supabase's port 5432.
#                   Schema changes and transaction pooling don't mix.
#   direct       <- a plain connection, no pooler in front of it.
DB_POOLER_MODE=direct
DB_ECHO=false

# ------------------------------------------------------------------- postgres
# Used by the database container when it first starts, not by the API.
POSTGRES_USER=iam
POSTGRES_PASSWORD=iam
POSTGRES_DB=iam

# --------------------------------------------------------------- email (P4)
# Mailpit in compose: it accepts everything and delivers nowhere, which is the
# right default for a system that emails people about access. A misconfigured
# environment should fail to reach anybody rather than mail a real person.
# UI on http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=iam@demo.local
# Set false to log what would have been sent instead of sending it. Approvals
# never fail because of mail either way — see apps/api/iam/mail.py.
MAIL_ENABLED=true

# ------------------------------------------------------- authentik (P2 onward)
# Only needed once you start the idp profile:
#   docker compose --profile idp up
# Generate both:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTHENTIK_SECRET_KEY=dev-only-not-a-real-secret-change-me-too
AUTHENTIK_POSTGRES_PASSWORD=authentik
# Pin this to a current stable release rather than tracking latest.
AUTHENTIK_TAG=latest

# The admin account authentik creates on its first boot, so a fresh volume comes
# up ready instead of waiting on the setup wizard. Local only — this is the login
# for a throwaway identity provider on your own machine.
#
# Not a .local address, deliberately. .local is reserved for mDNS, and
# authentik's email validator refuses it — which shows up as SCIM users silently
# never syncing while groups sync fine, because the failure happens inside
# authentik before it sends us anything. .test, .example and .invalid are
# reserved the same way.
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@demo-corp.com
AUTHENTIK_BOOTSTRAP_PASSWORD=dev-only-authentik-admin-password

# The bearer token authentik uses to push accounts into the console over SCIM.
# Issue one, then paste it here and restart the idp profile:
#
#   cd apps/api && python -m scripts.issue_scim_token "authentik provisioning"
#
# Only its hash is stored on our side, so this is the only copy. Leave it empty
# and everything still starts — the sync just fails with a 401 that says so.
IAM_SCIM_TOKEN=

# ---------------------------------------------------------------- provisioning out

# The token the demo HRMS accepts. It goes two places: the HRMS container reads it
# to decide what to let in, and you paste the same value into the provisioning
# target you register in the console. Anything you like, as long as both match.
#
# On our side it is stored encrypted rather than hashed, because unlike an inbound
# token we have to be able to send it. Nothing reads it back out — rotating means
# entering a new one.
HRMS_SCIM_TOKEN=dev-only-hrms-scim-token

# The key those outbound tokens are encrypted with. Leave it empty and one is
# derived from SESSION_SECRET, which is fine locally and means one fewer secret to
# manage. Set it in production if you want the two to rotate independently —
# changing either makes every stored token undecryptable, and they have to be
# re-entered.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCIM_ENCRYPTION_KEY=

# Allow provisioning to a private or loopback address in production. Off, and it
# should stay off unless the downstream genuinely lives inside the network — which
# for an HRMS it often does. Link-local addresses are refused either way, with no
# switch to turn that off, because that is where cloud metadata services live.
# See docs/adr/0007-outbound-requests-go-only-where-an-admin-configured.md.
ALLOW_PRIVATE_PROVISIONING_TARGETS=false

# Where the built frontend lives, for the production shape where this process
# serves the site as well as the API. Leave it empty locally: Caddy proxies the Vite
# dev server instead, and pointing this at a stale dist would serve yesterday's
# frontend while you edit today's.
#
# The production image sets it to /srv/static and bakes the bundle in, so there is
# nothing to set by hand on a deploy.
# See docs/adr/0008-one-server-serves-both-halves-in-production.md.
STATIC_DIR=
