# Copy to .env and adjust. Never commit .env.
#
#   cp .env.example .env
#
# docker compose reads this file automatically and injects these into the api
# container. For running the API natively, activate the venv and export these
# yourself (see README).

# ---------------------------------------------------------------- application
APP_ENV=local
LOG_LEVEL=INFO

# The single origin everything is served from. Caddy listens here; the SPA, the
# API, the SAML endpoints and the SCIM endpoints all live behind it. In P7 this
# becomes your real https:// hostname and feeds the SAML entity IDs.
BASE_URL=http://localhost:8080

# Signs the session cookie. Generate a real one for anything non-local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-not-a-real-secret-change-me

# ----------------------------------------------------------------- database
# Local Postgres from docker compose. In P7 these point at Supabase, and the
# two URLs stop being identical — see the pooler notes below.
DATABASE_URL=postgresql+asyncpg://iam:iam@db:5432/iam
ALEMBIC_DATABASE_URL=postgresql+asyncpg://iam:iam@db:5432/iam

# direct | session | transaction
#
# Local Postgres is "direct". Supabase has three connection paths and picking
# wrong costs an afternoon:
#
#   transaction  port 6543  <- app runtime on Supabase. Breaks prepared
#                              statements, so db.py disables them and drops
#                              SQLAlchemy pooling (Supavisor pools already).
#   session      port 5432  <- Alembic on Supabase. DDL and transaction-mode
#                              pooling do not mix.
#   direct       port 5432  <- IPv6-only on newer projects; IPv4 is paid.
DB_POOLER_MODE=direct
DB_ECHO=false

# ------------------------------------------------------------------- postgres
# Consumed by the db container's entrypoint, not by the API.
POSTGRES_USER=iam
POSTGRES_PASSWORD=iam
POSTGRES_DB=iam

# ------------------------------------------------------- authentik (P2 onward)
# Only needed once you start the idp profile:
#   docker compose --profile idp up
# Generate both:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTHENTIK_SECRET_KEY=dev-only-not-a-real-secret-change-me-too
AUTHENTIK_POSTGRES_PASSWORD=authentik
# Pin this to a current stable release rather than tracking latest.
AUTHENTIK_TAG=latest
